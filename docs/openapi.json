    "/api/bookings/{reference}/pay": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Pay for a booking (mock)",
        "description": "Pays a `pending` booking with a mock payment token. No card number is ever sent. (S07)\n\n- `tok_success` pays.\n- `tok_declined` is declined: you get `402 PAYMENT_DECLINED`, the booking stays pending, and you can try again.\n\nPaying a paid or cancelled booking is refused with `INVALID_TRANSITION`, and the card is never charged twice.",
        "operationId": "pay",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "description": "Booking reference, for example `A4WMMBBT`",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "paymentToken"
                ],
                "properties": {
                  "paymentToken": {
                    "type": "string",
                    "enum": [
                      "tok_success",
                      "tok_declined"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The booking, now paid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "The input is missing or wrong. Possible codes: `VALIDATION`, `INVALID_JSON`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "A missing, invalid or expired bearer token. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "The mock card was declined. Possible codes: `PAYMENT_DECLINED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "You are not the owner. Possible codes: `FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist (or is a draft you cannot see). Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The booking is already paid or cancelled. Possible codes: `INVALID_TRANSITION`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/bookings/{reference}/cancel": {
      "post": {
        "tags": [
          "Bookings"
        ],
        "summary": "Cancel an unpaid booking",
        "description": "Cancels a `pending` booking and gives its seats back. Paid bookings need a refund, which arrives in Build 8.",
        "operationId": "cancel",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "description": "Booking reference, for example `A4WMMBBT`",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The booking, now cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "401": {
            "description": "A missing, invalid or expired bearer token. Possible codes: `UNAUTHENTICATED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "You are not the owner. Possible codes: `FORBIDDEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "It does not exist (or is a draft you cannot see). Possible codes: `NOT_FOUND`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The booking is paid or already cancelled. Possible codes: `INVALID_STATE`, `INVALID_TRANSITION`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "attendee",
              "organizer",
              "staff"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "SOLD_OUT"
              },
              "message": {
                "type": "string",
                "example": "Only 1 ticket(s) left in General"
              }
            }
          }
        }
      },
      "NewEvent": {
        "type": "object",
        "required": [
          "title",
          "city",
          "startsAt"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Lagos Tech Meetup"
          },
          "city": {
            "type": "string",
            "example": "Lagos"
          },
          "venue": {
            "type": "string",
            "example": "Landmark Centre"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-12-05T17:00:00Z"
          }
        }
      },
      "EventSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published"
            ]
          },
          "tierCount": {
            "type": "integer"
          },
          "minPriceCents": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Price of the cheapest tier, or null with no tiers."
          },
          "seatsLeft": {
            "type": "integer",
            "description": "Seats left across all tiers."
          }
        }
      },
      "EventDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/EventSummary"
          },
          {
            "type": "object",
            "properties": {
              "organizerId": {
                "type": "string"
              },
              "tiers": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Tier"
                }
              }
            }
          }
        ]
      },
      "NewTier": {
        "type": "object",
        "required": [
          "name",
          "priceCents",
          "capacity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "General"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0,
            "example": 500000
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "example": 100
          }
        }
      },
      "Tier": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer"
          },
          "capacity": {
            "type": "integer"
          },
          "sold": {
            "type": "integer"
          },
          "seatsLeft": {
            "type": "integer"
          }
        }
      },
      "NewBooking": {
        "type": "object",
        "required": [
          "tierId",
          "quantity"
        ],
        "properties": {
          "tierId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "example": 2
          }
        }
      },
      "Booking": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "string",
            "example": "A4WMMBBT"
          },
          "eventId": {
            "type": "string"
          },
          "tierId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "amountCents": {
            "type": "integer",
            "description": "Tier price times quantity."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "cancelled",
              "refunded",
              "checked_in"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
