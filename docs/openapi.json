{
  "openapi": "3.1.0",
  "info": {
    "title": "Event Ticketing API",
    "version": "0.7.0",
    "description": "Sign up and log in, then use the returned bearer token for protected calls. Passwords are stored as scrypt hashes.\n\nThe API supports creating events and ticket tiers, publishing, searching, booking, mock payment and cancellation.\n\nSince Build 5, data is stored in **SQLite** (`data/ticketing.db`) and survives a restart. When many people book the last seats at the same moment, exactly enough of them succeed and the rest get `SOLD_OUT`.\n\n**Roles.** Signup accepts `attendee`, `organizer` or `staff`. The API enforces role and ownership checks.\n\n**Money** is always a whole number of the smallest unit (kobo or cents): `500000` is 5,000.00.\n\n**Errors** always have the same shape: `{ \"error\": { \"code\": \"SOLD_OUT\", \"message\": \"...\" } }`."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Sign up, log in and inspect the current account."
    },
    {
      "name": "Events",
      "description": "Organizers create and publish events. Anyone can search published ones."
    },
    {
      "name": "Bookings",
      "description": "Attendees book, pay and cancel. Only the person who made a booking can see or change it."
    },
    {
      "name": "System"
    }
  ],
  "paths": {
    "/api/auth/signup": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Create an account",
        "operationId": "signup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "attendee",
                      "organizer",
                      "staff"
                    ],
                    "default": "attendee"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The account and signed bearer token. No password is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "The input is missing or wrong. Possible codes: `VALIDATION`, `INVALID_JSON`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "An account already uses this email. Possible codes: `EMAIL_TAKEN`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
